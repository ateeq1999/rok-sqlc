[package]
name = "actix-api"
version = "0.1.0"
edition = "2024"
rust-version = "1.94"
publish = false

# What the skeleton and the generated code need: `rok-sqlc.toml`'s hints and
# the generated `src/db/mod.rs`'s.
[dependencies]
actix-web = "4"
chrono = { version = "0.4", features = ["serde"] }
jsonwebtoken = { version = "11", features = ["rust_crypto"] }
serde = { version = "1", features = ["derive"] }
serde_json = "1"
sqlx = { version = "0.9", features = ["runtime-tokio", "postgres", "derive", "uuid", "chrono", "json"] }
thiserror = "2"
tracing = "0.1"
tracing-subscriber = { version = "0.3", features = ["env-filter"] }
utoipa = { version = "5", features = ["chrono", "uuid"] }
utoipa-swagger-ui = { version = "9", features = ["actix-web", "vendored"] }
uuid = { version = "1", features = ["v7", "serde"] }
validator = { version = "0.21", features = ["derive"] }

[lints.rust]
unsafe_code = "forbid"

# The starters' strictness: no unwrap, expect or panic outside tests, and no
# leftover debugging.
[lints.clippy]
unwrap_used = "deny"
expect_used = "deny"
panic = "deny"
todo = "deny"
unimplemented = "deny"
dbg_macro = "deny"
print_stdout = "deny"
