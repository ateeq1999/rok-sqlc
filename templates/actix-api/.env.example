# Copy to `.env` (or export these) and adjust. `src/config.rs` reads them;
# the application itself loads no `.env` file.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/actix_api
JWT_SECRET=change-me-to-a-long-random-string
BIND_ADDR=127.0.0.1:8080
# Pool settings, all optional:
# DB_MAX_CONNECTIONS=20
# DB_MIN_CONNECTIONS=5
# DB_ACQUIRE_TIMEOUT_SECS=3
# DB_IDLE_TIMEOUT_SECS=600
# DB_MAX_LIFETIME_SECS=1800
# The log filter (default info), such as debug or info,sqlx=warn:
# RUST_LOG=info
