# Copy to `.env` (or export these) and adjust. `src/config.rs` reads them;
# the application itself loads no `.env` file.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/actix_api
# At least 32 bytes; make one with `openssl rand -base64 48`:
JWT_SECRET=change-me-to-a-long-random-string
# Two-factor secrets are encrypted with it: 32 bytes in base64; make one with
# `openssl rand -base64 32`:
TOTP_ENCRYPTION_KEY=
BIND_ADDR=127.0.0.1:8080
# Seconds an issued token lasts (default 3600):
# JWT_TTL=3600
# Sign-in answers 403 until the email is verified (default true):
# REQUIRE_VERIFIED_EMAIL=true
# The base of the links mails carry, such as {APP_URL}/verify-email?token=...
# (default http://localhost:8080):
# APP_URL=http://localhost:8080
# How mail leaves: log (logged, not sent; the default; RUST_LOG=debug shows
# each body and its links) or smtp:
# MAIL_TRANSPORT=log
# Required when MAIL_TRANSPORT=smtp (smtps:// for TLS, or smtp://...?tls=required
# for STARTTLS):
# SMTP_URL=smtps://user:password@smtp.example.com:465
# The sender of every mail (default Actix API <no-reply@localhost>):
# MAIL_FROM=Actix API <no-reply@localhost>
# Reject passwords found in Have I Been Pwned's breaches (default false):
# BREACH_CHECK=false
# Take the client IP from X-Forwarded-For; only behind a proxy you run
# (default false):
# TRUST_PROXY=false
# Requests per minute per IP on /auth (default 20; 0 turns the limit off):
# AUTH_RATE_LIMIT=20
# Where uploads are stored: file://<dir> (default file://./storage), s3://<bucket>
# (with the AWS_* variables: AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_REGION,
# and AWS_ENDPOINT plus AWS_ALLOW_HTTP=true for MinIO) or memory://:
# STORAGE_URL=file://./storage
# The largest upload, in bytes (default 10485760, 10 MiB):
# MEDIA_MAX_UPLOAD_BYTES=10485760
# The types an upload may have, detected from its bytes:
# MEDIA_ALLOWED_TYPES=image/jpeg,image/png,image/webp,image/gif,application/pdf
# Pool settings, all optional:
# DB_MAX_CONNECTIONS=20
# DB_MIN_CONNECTIONS=5
# DB_ACQUIRE_TIMEOUT_SECS=3
# DB_IDLE_TIMEOUT_SECS=600
# DB_MAX_LIFETIME_SECS=1800
# The log filter (default info), such as debug or info,sqlx=warn:
# RUST_LOG=info
